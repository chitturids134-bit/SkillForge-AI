# SkillForge AI - Production Environment Variables Template
# Copy this file to .env and replace placeholder values with actual secrets.

# MongoDB Connection String (Atlas or Local Fallback)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/skillforge_ai?retryWrites=true&w=majority

# Express Server Port
PORT=5000

# JSON Web Token Secret Key
JWT_SECRET=super_secret_production_jwt_signing_key_skillforge_ai_2026

# Google Gemini / LLM API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# Primary System Admin Credentials (Single-Admin Rule)
PRIMARY_ADMIN_EMAIL=devadharshinichitturi95@gmail.com
PRIMARY_ADMIN_PASSWORD=DevaAdmin123!
